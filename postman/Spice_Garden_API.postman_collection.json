        {
          "name": "Create Order (Bangalore Address)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('testOrderId', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"food\": \"{{testFoodId}}\",\n      \"quantity\": 2\n    }\n  ],\n  \"deliveryAddress\": {\n    \"street\": \"#15, 12th Main, HAL 2nd Stage\",\n    \"area\": \"Indiranagar\",\n    \"landmark\": \"Near Metro Station\",\n    \"city\": \"Bangalore\",\n    \"pincode\": \"560038\",\n    \"instructions\": \"Please call before arrival\"\n  },\n  \"paymentMethod\": \"Online Payment\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Get Customer Orders (/my-orders)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/my-orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "my-orders"]
            }
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{testOrderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{testOrderId}}"]
            }
          }
        },
        {
          "name": "Cancel Order (Only if 'Order Placed')",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Changed dining plans\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{testOrderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{testOrderId}}", "cancel"]
            }
          }
        },
        {
          "name": "Submit Customer Review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{testOrderId}}\",\n  \"rating\": 5,\n  \"comment\": \"Incredible Biryani! Delivered piping hot to Indiranagar within 30 minutes. Super aromatic with authentic desi ghee!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["reviews"]
            }
          }
        }
      ]
    },
