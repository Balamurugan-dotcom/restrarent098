            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"phone\": \"9845099999\",\n  \"address\": {\n    \"street\": \"#42, 100 Feet Road\",\n    \"area\": \"Indiranagar\",\n    \"city\": \"Bangalore\",\n    \"pincode\": \"560038\"\n  }\n}"
